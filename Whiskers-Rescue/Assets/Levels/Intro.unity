  m_Script: {fileID: 11500000, guid: cb656589e4a794242bc75e3e365ce1d4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextAppear
  textMesh: {fileID: 2043048910}
  hintText: {fileID: 235218810}
  message: "A long time ago, a human threw a ball into the sky. It went so high that
    it never came back.  A dog named Papuchino chased after it without thinking.
    He kept running and running until he somehow ended up stuck far up in the sky,
    lost and unable to get back down.  Now a small cat named Whiskers has taken it
    upon herself to find him. She believes Papuchino is still out there, waiting,
    and she won\u2019t stop until she brings her friend back home."
  delay: 0.05
